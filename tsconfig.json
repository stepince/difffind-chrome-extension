{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["config.js", "launcher.js", "background.js", "popup.js"]
}
