{
  "name": "difffind-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate",
    "build": "make build"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "puppeteer-core": "25.12.0",
    "typescript": "7.0.2"
  }
}
