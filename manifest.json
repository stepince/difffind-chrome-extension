{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "DiffFind Launcher",
  "version": "0.1.0",
  "description": "Open DiffFind, hosted or self-hosted, in a dedicated window, or return to the one you already have open.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open DiffFind",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
